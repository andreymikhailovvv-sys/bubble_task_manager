generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AiMessageRole {
  user
  assistant
}

enum TelegramSessionMode {
  IDLE
  AWAITING_LINK_CREDENTIALS
  AWAITING_AI_MESSAGE
  AI_CHAT
}

enum HabitRecurrenceType {
  DAILY
  INTERVAL
  WEEKDAYS
}

enum HabitDurationMode {
  FOREVER
  UNTIL_DATE
  REPEAT_COUNT
}

enum HabitCompletionSource {
  MANUAL
  AUTO_DURATION
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  deviceId     String?  @unique
  name         String?
  googleSub    String?  @unique
  avatarUrl    String?
  timeZone     String?
  morningAiCheckupEnabled Boolean @default(false)
  morningAiCheckupTime String @default("10:00")
  lastMorningAiCheckupDate String?
  telegramChatId String?  @unique
  telegramLinkedAt DateTime?
  aiCredits    Int      @default(100)
  aiCreditsPeriod String @default("")
  aiEfficiencyCreditsSpent Int @default(0)
  aiEfficiencyCreditsPeriod String @default("")
  efficiencyScore Float @default(0)
  spheres      Sphere[]
  tasks        Task[]
  aiMessages   TaskAiMessage[]
  generalAiMessages GeneralAiMessage[]
  taskAttachments TaskAttachment[]
  telegramSessions TelegramSession[]
  habits       Habit[]
  habitCompletions HabitCompletion[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model Sphere {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60a5fa")
  icon      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model Task {
  id                  String     @id @default(cuid())
  title               String
  description         String?
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphereId            String?
  sphere              Sphere?    @relation(fields: [sphereId], references: [id], onDelete: SetNull)
  parentTaskId        String?
  parentTask          Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks            Task[]     @relation("TaskSubtasks")
  importance          Int        @default(3)
  urgency             Int        @default(3)
  priorityScore       Float      @default(3)
  status              TaskStatus @default(TODO)
  dueDate             DateTime?
  notifyBeforeMinutes Int?       @default(60)
  isRecurring         Boolean    @default(false)
  recurrenceText      String?
  recurrenceJson      Json?
  recurrenceSummary   String?
  recurrenceUntil     DateTime?
  overdueAiNotifiedAt DateTime?
  aiNotificationsEnabled Boolean @default(true)
  telegramNotifiedAt  DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  attachments         TaskAttachment[]
  aiMessages          TaskAiMessage[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sphereId])
  @@index([parentTaskId])
  @@index([status])
}

model TaskAiMessage {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([taskId, createdAt])
  @@index([taskId, userId, createdAt])
}

model GeneralAiMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}


model TaskAttachment {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  mimeType      String
  size          Int
  contentBase64 String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([taskId, createdAt])
}



model Habit {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  icon           String              @default("✨")
  color          String              @default("#22c55e")
  targetCount    Int                 @default(1)
  recurrenceType HabitRecurrenceType @default(DAILY)
  intervalDays   Int?
  weekdays       Json                @default("[]")
  reminderTime   String?
  reminderTimes  Json                @default("[]")
  reminderSnoozedUntil DateTime?
  lastReminderNotifiedKey String?
  durationMode   HabitDurationMode   @default(FOREVER)
  endDate        DateTime?
  totalRepeatTarget Int?
  isAutoCompleted Boolean            @default(false)
  autoCompletedAt DateTime?
  isArchived     Boolean             @default(false)
  completions    HabitCompletion[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@index([userId, isArchived, createdAt])
  @@index([userId, isAutoCompleted])
}

model HabitCompletion {
  id                 String   @id @default(cuid())
  habitId            String
  habit              Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey            String
  amount             Int      @default(1)
  targetAtCompletion Int
  recurrenceSnapshot Json?
  source             HabitCompletionSource @default(MANUAL)
  completedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([habitId])
  @@index([userId])
  @@index([habitId, dateKey])
  @@index([userId, dateKey])
  @@index([completedAt])
}

model TelegramSession {
  chatId       String              @id
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  mode         String @default("IDLE")
  activeTaskId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model SubscriptionLink {
  planKey   String   @id
  url       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
