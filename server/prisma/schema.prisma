generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  deviceId     String?  @unique
  name         String?
  googleSub    String?  @unique
  avatarUrl    String?
  spheres      Sphere[]
  tasks        Task[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model Sphere {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60a5fa")
  icon      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model Task {
  id                  String     @id @default(cuid())
  title               String
  description         String?
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphereId            String?
  sphere              Sphere?    @relation(fields: [sphereId], references: [id], onDelete: SetNull)
  parentTaskId        String?
  parentTask          Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks            Task[]     @relation("TaskSubtasks")
  importance          Int        @default(3)
  urgency             Int        @default(3)
  priorityScore       Float      @default(3)
  status              TaskStatus @default(TODO)
  dueDate             DateTime?
  notifyBeforeMinutes Int?       @default(60)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sphereId])
  @@index([parentTaskId])
  @@index([status])
}
