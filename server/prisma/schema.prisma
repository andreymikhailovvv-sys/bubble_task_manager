generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum TaskType {
  TASK
  EVENT
  REMINDER
}

enum AiMessageRole {
  user
  assistant
}

enum TelegramSessionMode {
  IDLE
  AWAITING_LINK_CREDENTIALS
  AWAITING_AI_MESSAGE
  AI_CHAT
}

enum TelegramUpdateJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum UserConsentType {
  PERSONAL_DATA_PROCESSING
}

model TelegramUpdateJob {
  id                  String                  @id @default(cuid())
  updateId            BigInt                  @unique
  payload             Json
  status              TelegramUpdateJobStatus @default(PENDING)
  attempts            Int                     @default(0)
  nextAttemptAt       DateTime                @default(now())
  processingStartedAt DateTime?
  processedAt         DateTime?
  lastError           String?
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([status, nextAttemptAt])
  @@index([status, processingStartedAt])
}

enum HabitRecurrenceType {
  DAILY
  INTERVAL
  WEEKDAYS
}

enum HabitDurationMode {
  FOREVER
  UNTIL_DATE
  REPEAT_COUNT
}

enum HabitCompletionSource {
  MANUAL
  AUTO_DURATION
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  deviceId     String?  @unique
  name         String?
  googleSub    String?  @unique
  avatarUrl    String?
  timeZone     String?
  aiTaskAutoApply Boolean @default(false)
  aiTaskProposals AiTaskProposal[]
  morningAiCheckupEnabled Boolean @default(false)
  morningAiCheckupTime String @default("10:00")
  lastMorningAiCheckupDate String?
  telegramChatId String?  @unique
  telegramLinkedAt DateTime?
  subscriptionPlan String @default("free")
  aiCredits    Int      @default(0)
  aiCreditsPeriod String @default("")
  aiIncludedCreditsMilli Int @default(0)
  aiTrialGrantedAt DateTime?
  aiBonusCreditsMilli Int @default(0)
  aiPurchasedCreditsMilli Int @default(0)
  aiEfficiencyCreditsSpent Int @default(0)
  aiEfficiencyCreditsPeriod String @default("")
  efficiencyScore Float @default(0)
  efficiencyTaskScore Float @default(0)
  efficiencyHabitScore Float @default(0)
  efficiencyAiScore Float @default(0)
  efficiencyFocusScore Float @default(0)
  efficiencyLastActivityAt DateTime?
  completedLessonIds String[] @default([])
  spheres      Sphere[]
  tasks        Task[]
  aiMessages   TaskAiMessage[]
  generalAiMessages GeneralAiMessage[]
  aiChatProjects Json?
  taskAttachments TaskAttachment[]
  aiConversationAttachments AiConversationAttachment[]
  telegramSessions TelegramSession[]
  telegramUserClientConnection TelegramUserClientConnection?
  telegramUserReadLease TelegramUserReadLease?
  telegramUserClientSendAudits TelegramUserClientSendAudit[]
  telegramQuickSendJobs TelegramQuickSendJob[]
  telegramAiReadRequests TelegramAiReadRequest[]
  telegramAiChatPolicies TelegramAiChatPolicy[]
  telegramAiInboxEvents TelegramAiInboxEvent[]
  telegramAiTaskApprovals TelegramAiTaskApproval[]
  telegramAiMonitorCalls TelegramAiMonitorCall[]
  habits       Habit[]
  systemNotifications SystemNotification[]
  habitCompletions HabitCompletion[]
  consents     UserConsent[]
  aiUsageEvents AiUsageEvent[]
  aiCreditReservationRecords AiCreditReservationRecord[]
  aiChatRequests AiChatRequest[]
  aiChatConversationMemories AiChatConversationMemory[]
  creditPurchases CreditPurchase[]
  collaborativeTaskMembers CollaborativeTaskMember[]
  taskComments TaskComment[] @relation("TaskCommentAuthor")
  taskCommentReadStates TaskCommentReadState[]
  generatedDocuments AiGeneratedDocument[]
  standaloneNotes StandaloneNote[]
  standaloneNoteGroups StandaloneNoteGroup[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
  @@index([subscriptionPlan])
}

model AiChatConversationMemory {
  id                         String   @id @default(cuid())
  userId                     String
  user                       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId                  String
  chatId                     String
  summary                    Json
  summarizedThroughMessageId String?
  revision                   Int      @default(0)
  formatVersion              Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@unique([userId, projectId, chatId])
  @@index([userId])
  @@index([userId, updatedAt])
}

model AiUsageEvent {
  id                    String   @id @default(cuid())
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId             String
  actionId              String?
  providerCallIndex     Int?
  feature               String
  model                 String
  openAiResponseId      String?
  inputTokens           Int
  cachedInputTokens     Int
  cacheWriteTokens      Int
  outputTokens          Int
  reasoningTokens       Int
  totalTokens           Int
  providerCostNanoUsd   BigInt?
  estimatedCreditsMilli Int?
  pricingVersion        String
  billingMode           String   @default("SHADOW")
  createdAt             DateTime @default(now())

  @@index([userId, createdAt])
  @@index([requestId])
  @@index([actionId])
}

// Per-user request deduplication for the general AI chat. An interrupted
// execution must not be transparently retried because actions may have run.
model AiTaskProposal {
  id          String @id @default(cuid())
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String
  source      String
  taskId      String?
  operations  Json
  display     Json
  resolvedIds Json?
  snapshots   Json?
  undoData    Json?
  userTimeZone String @default("Europe/Moscow")
  autoApplied Boolean @default(false)
  status      String @default("PENDING")
  result      Json?
  error       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, requestId])
  @@index([userId, status, createdAt])
}

model AiChatRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientRequestId String
  payloadSha256    String
  status          String   @default("PROCESSING")
  responseJson    Json?
  createdAt       DateTime @default(now())
  completedAt     DateTime?

  @@unique([userId, clientRequestId])
  @@index([status, createdAt])
}

model AiCreditReservationRecord {
  id                   String   @id
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  period               String
  includedMilli        Int
  bonusMilli           Int
  purchasedMilli       Int
  totalMilli           Int
  status               String   @default("RESERVED")
  chargedMilli         Int      @default(0)
  refundedMilli        Int      @default(0)
  expiredIncludedMilli Int      @default(0)
  createdAt            DateTime @default(now())
  settledAt            DateTime?

  @@index([userId, status])
}

model UserConsent {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       UserConsentType
  version    String
  acceptedAt DateTime        @default(now())
  ipAddress  String?

  @@unique([userId, type, version])
  @@index([userId])
}

model Sphere {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60a5fa")
  icon      String?
  generalPrompt String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model Task {
  id                  String     @id @default(cuid())
  title               String
  description         String?
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphereId            String?
  sphere              Sphere?    @relation(fields: [sphereId], references: [id], onDelete: SetNull)
  parentTaskId        String?
  taskType            TaskType   @default(TASK)
  location            String?
  parentTask          Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks            Task[]     @relation("TaskSubtasks")
  importance          Int        @default(3)
  urgency             Int        @default(3)
  priorityScore       Float      @default(3)
  status              TaskStatus @default(TODO)
  dueDate             DateTime?
  notifyBeforeMinutes Int?       @default(0)
  isRecurring         Boolean    @default(false)
  recurrenceText      String?
  recurrenceJson      Json?
  recurrenceSummary   String?
  recurrenceUntil     DateTime?
  overdueAiNotifiedAt DateTime?
  aiNotificationsEnabled Boolean @default(true)
  telegramNotifiedAt  DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  attachments         TaskAttachment[]
  aiMessages          TaskAiMessage[]
  aiConversationMemory TaskAiConversationMemory?
  collaborationId     String?
  collaboration       CollaborativeTask? @relation(fields: [collaborationId], references: [id], onDelete: SetNull)
  comments            TaskComment[]
  commentReadStates   TaskCommentReadState[]
  generatedDocuments  AiGeneratedDocument[]
  aiConversationAttachments AiConversationAttachment[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sphereId])
  @@index([parentTaskId])
  @@index([status])
  @@index([collaborationId])
}

model CollaborativeTask {
  id        String   @id @default(cuid())
  token     String   @unique
  rootTaskId String  @unique
  tasks     Task[]
  members   CollaborativeTaskMember[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CollaborativeTaskMember {
  id              String   @id @default(cuid())
  collaborationId String
  collaboration   CollaborativeTask @relation(fields: [collaborationId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphereId        String?
  color           String   @default("#8b5cf6")
  statusOverride  TaskStatus?
  isHidden        Boolean  @default(false)
  importance      Int      @default(3)
  urgency         Int      @default(3)
  notifyBeforeMinutes Int? @default(0)
  aiNotificationsEnabled Boolean @default(true)
  isRecurring     Boolean  @default(false)
  recurrenceText  String?
  recurrenceJson  Json?
  recurrenceSummary String?
  recurrenceUntil DateTime?
  telegramNotifiedAt DateTime?
  createdAt       DateTime @default(now())

  @@unique([collaborationId, userId])
  @@index([userId])
}

model TaskComment {
  id              String   @id @default(cuid())
  taskId          String
  task            Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User     @relation("TaskCommentAuthor", fields: [userId], references: [id], onDelete: Cascade)
  parentCommentId String?
  parentComment   TaskComment? @relation("TaskCommentReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies         TaskComment[] @relation("TaskCommentReplies")
  content         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([taskId, createdAt])
  @@index([userId])
  @@index([parentCommentId])
}

model TaskCommentReadState {
  id         String   @id @default(cuid())
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastReadAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([taskId, userId])
  @@index([userId])
}

model TaskAiMessage {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  creditsSpentMilli Int?
  messageKind String      @default("AI")
  recipientUserId String?
  telegramSendDraft Json?
  aiTaskProposalId String?
  telegramReadDraft Json?
  telegramReadOwnerId String?
  generatedDocumentId String? @unique
  generatedDocument AiGeneratedDocument? @relation(fields: [generatedDocumentId], references: [id], onDelete: SetNull)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([taskId, createdAt])
  @@index([taskId, userId, createdAt])
  @@index([taskId, messageKind, createdAt])
  @@index([recipientUserId, createdAt])
}

model TaskAiConversationMemory {
  id                         String   @id @default(cuid())
  taskId                     String   @unique
  task                       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId                     String
  summary                    Json
  summarizedThroughMessageId String
  summarizedThroughCreatedAt DateTime
  revision                   Int      @default(0)
  formatVersion              Int      @default(1)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  @@index([userId])
  @@index([userId, updatedAt])
}

model GeneralAiMessage {
  aiTaskProposalId String?
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  creditsSpentMilli Int?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}


// Durable copies of files uploaded in AI chat messages. Each attachment
// is scoped to its originating request and the owning chat or task.
model AiConversationAttachment {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId     String?
  chatId        String?
  messageId     String
  ordinal       Int
  fileName      String
  mimeType      String
  size          Int
  contentBase64 String
  createdAt     DateTime  @default(now())

  @@unique([userId, messageId, ordinal])
  @@index([userId, taskId, createdAt])
  @@index([userId, projectId, chatId, createdAt])
  @@index([userId, messageId])
}

model AiGeneratedDocument {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId        String?
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  fileName      String
  mimeType      String   @default("application/vnd.openxmlformats-officedocument.wordprocessingml.document")
  size          Int
  contentBase64 String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  taskAiMessage TaskAiMessage?

  @@index([userId, createdAt])
  @@index([taskId, createdAt])
}

model SystemNotification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId    String?
  eventKey  String   @unique
  content   String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}


model TaskAttachment {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  mimeType      String
  size          Int
  contentBase64 String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([taskId, createdAt])
}



model Habit {
  id             String              @id @default(cuid())
  userId         String
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name           String
  icon           String              @default("✨")
  color          String              @default("#22c55e")
  targetCount    Int                 @default(1)
  recurrenceType HabitRecurrenceType @default(DAILY)
  intervalDays   Int?
  weekdays       Json                @default("[]")
  reminderTime   String?
  reminderTimes  Json                @default("[]")
  reminderSnoozedUntil DateTime?
  lastReminderNotifiedKey String?
  durationMode   HabitDurationMode   @default(FOREVER)
  endDate        DateTime?
  totalRepeatTarget Int?
  isAutoCompleted Boolean            @default(false)
  autoCompletedAt DateTime?
  isArchived     Boolean             @default(false)
  finishedAt     DateTime?
  completions    HabitCompletion[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([userId])
  @@index([userId, isArchived, createdAt])
  @@index([userId, isAutoCompleted])
}

model HabitCompletion {
  id                 String   @id @default(cuid())
  habitId            String
  habit              Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dateKey            String
  amount             Int      @default(1)
  targetAtCompletion Int
  recurrenceSnapshot Json?
  source             HabitCompletionSource @default(MANUAL)
  completedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([habitId])
  @@index([userId])
  @@index([habitId, dateKey])
  @@index([userId, dateKey])
  @@index([completedAt])
}

// Independent MTProto user-client credentials. Never reuse TelegramSession (Bot API dialog state).
// Cross-replica, account-scoped read lease. Contains no Telegram content or credentials.
model TelegramUserReadLease {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token      String
  expiresAt  DateTime
}

model TelegramUserClientConnection {
  userId            String   @id
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  pilotEnabled      Boolean  @default(false)
  encryptedApiCredentials String? @db.Text
  encryptedSession  String?  @db.Text
  telegramAccountId String?
  connectedAt       DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


// Audit metadata only. No message body, Telegram session or password is persisted.
model TelegramUserClientSendAudit {
  id                  String   @id
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientKind       String
  recipientTelegramId String
  result              String   @default("PENDING")
  createdAt           DateTime @default(now())
  completedAt         DateTime?

  @@index([userId, createdAt])
}

// Durable quick-share queue, encrypted payload, metadata-only status.
// A processed recipient is never retried after the outbound MTProto call begins.
model TelegramQuickSendJob {
  id                String   @id
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  state             String   @default("QUEUED")
  stage             String   @default("SEND")
  encryptedPayload  String?  @db.Text
  recipientCount    Int
  recipientIndex    Int      @default(0)
  sentCount         Int      @default(0)
  unknownCount      Int      @default(0)
  failedCount       Int      @default(0)
  nextRunAt         DateTime @default(now())
  claimedAt         DateTime?
  completedAt       DateTime?
  createdAt         DateTime @default(now())

  @@index([state, nextRunAt])
  @@index([userId, createdAt])
}

// Consent state only. Telegram texts never enter database, audit or client
// history; one-time consent is scoped to owner, chat, message count and TTL.
model TelegramAiReadRequest {
  id              String   @id
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId          String?
  requestedName   String
  suggestedId     String?
  suggestedName   String?
  state           String   @default("PENDING")
  createdAt       DateTime @default(now())
  claimedAt       DateTime?
  @@index([userId, createdAt])
}

// Opt-in configuration only. No Telegram message bodies or tokens in this table.
// PR1 never sets isEnabled=true; later PRs must explicitly activate a profile.
model TelegramAiChatPolicy {
  id                      String   @id @default(cuid())
  userId                  String
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatId                  String
  chatKind                String
  chatTitle               String
  mode                    String   @default("OBSERVE")
  taskMode                String   @default("SUGGEST")
  checkIntervalMinutes    Int      @default(30) // Legacy: kept for backward compatibility
  interactionIntervalMinutes Int   @default(5) // 0 = near-immediate polling, minimum 15 seconds
  autoReplyIntervalMinutes Int   @default(5)
  summaryIntervalMinutes  Int      @default(30) // -1 = summaries off
  summaryInstructions     String   @default("") @db.Text
  suggestWhen             String   @default("") @db.Text
  suggestHow              String   @default("") @db.Text
  monitorModel            String   @default("gpt-6-luna")
  instructions            String   @default("") @db.Text
  autoReplyWhen          String   @default("") @db.Text
  autoReplyHow           String   @default("") @db.Text
  notifyImportant         Boolean  @default(true)
  reviewAttachments       Boolean  @default(true)
  // NULL means no per-chat DAILY cap. Global wallet balance always applies.
  dailyCreditLimitMilli   Int?     @default(50000)
  isEnabled               Boolean  @default(false)
  lastSeenMessageId       Int?
  lastInteractionMessageId Int?
  lastSummaryMessageId    Int?
  lastTaskMessageId       Int?
  nextInteractionAt       DateTime?
  nextSummaryAt           DateTime?
  nextTaskAt              DateTime?
  lastCheckedAt           DateTime?
  nextCheckAt             DateTime?
  leaseToken              String?
  leasedUntil             DateTime?
  lastSummary             Json?
  lastSummaryAt           DateTime?
  lastError               String?
  monitorRevision         Int      @default(0)
  summaryRequested        Boolean  @default(false)
  creditDayKey            String?
  dailySpentMilli         Int      @default(0)
  dailyReservedMilli      Int      @default(0)
  totalSpentMilli         Int      @default(0)
  monitorCalls            TelegramAiMonitorCall[]
  autoReplyAttempts       TelegramAiAutoReplyAttempt[]
  inboxEvents             TelegramAiInboxEvent[]
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([userId, chatId])
  @@index([userId, isEnabled])
  @@index([isEnabled, nextCheckAt, leasedUntil], map: "TelegramAiChatPolicy_due_idx")
}

// Metadata-only provider call ledger; no Telegram text or access credentials.
model TelegramAiMonitorCall {
  id            String   @id
  policyId      String?
  policy        TelegramAiChatPolicy? @relation(fields: [policyId], references: [id], onDelete: SetNull)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reservationId String   @unique
  creditDayKey  String
  reservedMilli Int
  chargedMilli  Int      @default(0)
  state         String   @default("RESERVED")
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@index([state, createdAt])
  @@index([policyId, creditDayKey])
}

// Claim recorded BEFORE sending so a crash or a retry cannot duplicate an
// outbound MTProto message. No Telegram text or credentials stored.
model TelegramAiAutoReplyAttempt {
  id            String   @id @default(cuid())
  policyId      String
  policy        TelegramAiChatPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  messageId     Int
  status        String   @default("CLAIMED")
  createdAt     DateTime @default(now())
  completedAt   DateTime?

  @@unique([policyId, messageId])
  @@index([createdAt])
}

// Durable model-generated inbox messages, separate from browser-managed chat JSON.
// No raw Telegram messages or authentication material.
model TelegramAiInboxEvent {
  id               String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  policyId         String
  policy           TelegramAiChatPolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  taskModeAtPublish String @default("SUGGEST")
  messageId        Int
  content          String   @db.Text
  summary          Json
  suggestedReplyMessageId Int?
  suggestedReplyText      String? @db.Text
  suggestedReplyStatus    String @default("PENDING")
  model            String
  botStatus        String   @default("PENDING")
  botClaimedAt     DateTime?
  botDeliveredAt   DateTime?
  taskApprovals    TelegramAiTaskApproval[]
  createdAt        DateTime @default(now())

  @@index([policyId, messageId])
  @@index([userId, createdAt])
  @@index([botStatus, createdAt])
}

model TelegramAiTaskApproval {
  id          String   @id
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId     String
  event       TelegramAiInboxEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  itemIndex   Int
  taskId      String
  createdAt   DateTime @default(now())

  @@unique([eventId, itemIndex])
  @@index([userId, createdAt])
}

model TelegramSession {
  chatId       String              @id
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  mode         String @default("IDLE")
  activeTaskId String?
  registrationLogin String?
  registrationPasswordHash String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}

model SubscriptionLink {
  planKey   String   @id
  url       String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CreditPack {
  id            String   @id @default(cuid())
  key           String   @unique
  name          String
  creditsAmount Int
  price         Int
  paymentUrl    String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model CreditPurchase {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientRequestId   String
  creditPackKey     String
  creditsAmount     Int
  creditsMilli      Int
  amountKopecks     Int
  currency          String   @default("RUB")
  yookassaPaymentId String?  @unique
  idempotenceKey    String   @unique
  status            String   @default("created")
  confirmationUrl   String?
  providerStatus    String?
  providerCheckedAt DateTime?
  creditedAt        DateTime?
  canceledAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, clientRequestId])
  @@index([userId, createdAt])
  @@index([status])
}

// Personal notes independent of tasks and sectors; prepared for future AI search.
model StandaloneNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String   @default("")
  content   String   @default("") @db.Text
  groupId   String?
  group     StandaloneNoteGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([userId, groupId])
}

model StandaloneNoteGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String   @default("#8b5cf6")
  notes     StandaloneNote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, createdAt])
}
