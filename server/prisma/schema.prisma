generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum AiMessageRole {
  user
  assistant
}

enum TelegramSessionMode {
  IDLE
  AWAITING_LINK_CREDENTIALS
  AWAITING_AI_MESSAGE
  AI_CHAT
}

model User {
  id           String   @id @default(cuid())
  email        String?  @unique
  username     String?  @unique
  passwordHash String?
  deviceId     String?  @unique
  name         String?
  googleSub    String?  @unique
  avatarUrl    String?
  timeZone     String?
  telegramChatId String?  @unique
  telegramLinkedAt DateTime?
  aiCredits    Int      @default(100)
  aiCreditsPeriod String @default("")
  spheres      Sphere[]
  tasks        Task[]
  aiMessages   TaskAiMessage[]
  generalAiMessages GeneralAiMessage[]
  taskAttachments TaskAttachment[]
  telegramSessions TelegramSession[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([createdAt])
}

model Sphere {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#60a5fa")
  icon      String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tasks     Task[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}

model Task {
  id                  String     @id @default(cuid())
  title               String
  description         String?
  userId              String
  user                User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  sphereId            String?
  sphere              Sphere?    @relation(fields: [sphereId], references: [id], onDelete: SetNull)
  parentTaskId        String?
  parentTask          Task?      @relation("TaskSubtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks            Task[]     @relation("TaskSubtasks")
  importance          Int        @default(3)
  urgency             Int        @default(3)
  priorityScore       Float      @default(3)
  status              TaskStatus @default(TODO)
  dueDate             DateTime?
  notifyBeforeMinutes Int?       @default(60)
  isRecurring         Boolean    @default(false)
  recurrenceText      String?
  recurrenceJson      Json?
  recurrenceSummary   String?
  recurrenceUntil     DateTime?
  overdueAiNotifiedAt DateTime?
  telegramNotifiedAt  DateTime?
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  attachments         TaskAttachment[]
  aiMessages          TaskAiMessage[]

  @@index([userId])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([sphereId])
  @@index([parentTaskId])
  @@index([status])
}

model TaskAiMessage {
  id        String        @id @default(cuid())
  taskId    String
  task      Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([taskId, createdAt])
  @@index([taskId, userId, createdAt])
}

model GeneralAiMessage {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      AiMessageRole
  content   String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([userId])
  @@index([userId, createdAt])
}


model TaskAttachment {
  id            String   @id @default(cuid())
  taskId        String
  task          Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  mimeType      String
  size          Int
  contentBase64 String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
  @@index([taskId, createdAt])
}


model TelegramSession {
  chatId       String              @id
  userId       String?
  user         User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  mode         String @default("IDLE")
  activeTaskId String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([userId])
}
