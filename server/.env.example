PORT=4000
DATABASE_URL="file:./dev.db"
CLIENT_DIST_PATH=../client/dist
# Новый tool-based planner для обычного AI-чата. По умолчанию выключен.
AI_CHAT_PLANNER_TOOLS_ENABLED=false
# Shadow-телеметрия фактического usage OpenAI. По умолчанию включена.
# AI_USAGE_SHADOW_ENABLED=false
# Динамическое списание только для POST /api/tasks/:id/ai-chat. По умолчанию выключено.
AI_DYNAMIC_TASK_CHAT_BILLING_ENABLED=false
# Опциональный comma-separated canary allowlist user ID.
# AI_DYNAMIC_TASK_CHAT_BILLING_USER_IDS=user-id-1,user-id-2
# Компактный контекст task chat с token-budget history. По умолчанию выключен.
TASK_CHAT_CONTEXT_V2_ENABLED=false
# Опциональный comma-separated canary allowlist user ID.
# TASK_CHAT_CONTEXT_V2_USER_IDS=user-id-1,user-id-2
# Rolling memory task chat (работает только вместе с Context V2).
TASK_CHAT_MEMORY_ENABLED=false
# Опциональный comma-separated canary allowlist user ID. Пустой список включает для всех.
# TASK_CHAT_MEMORY_USER_IDS=user-id-1,user-id-2
OPENAI_MODEL_TASK_CHAT_MEMORY=gpt-6-luna
TASK_CHAT_MEMORY_BATCH_TOKEN_LIMIT=12000
TASK_CHAT_MEMORY_MAX_BATCHES_PER_REQUEST=3
# Опциональный исходящий прокси только для OpenAI
# OPENAI_PROXY_URL=http://1.2.3.4:8080
# OPENAI_PROXY_USERNAME=proxy_user
# OPENAI_PROXY_PASSWORD=proxy_password
# Опциональный исходящий прокси только для Telegram Bot API
# TELEGRAM_PROXY_URL=http://1.2.3.4:8080
# TELEGRAM_PROXY_USERNAME=proxy_user
# TELEGRAM_PROXY_PASSWORD=proxy_password

# Dynamic billing for non-task-chat text workflows. Empty allowlist enables all users.
AI_DYNAMIC_TEXT_BILLING_ENABLED=false
# AI_DYNAMIC_TEXT_BILLING_USER_IDS=user-id-1,user-id-2
