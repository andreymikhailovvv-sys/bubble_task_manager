PORT=4000
DATABASE_URL="file:./dev.db"
# Required for local JWT and signed guest device cookies. Never commit a real value.
# Generate with: openssl rand -hex 32
JWT_SECRET=
# Server-only YooKassa credentials.
# Never expose YOOKASSA_SECRET_KEY to the client.
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
CLIENT_DIST_PATH=../client/dist
# Новый tool-based planner для обычного AI-чата. По умолчанию выключен.
AI_CHAT_PLANNER_TOOLS_ENABLED=false
# Shadow-телеметрия фактического usage OpenAI. По умолчанию включена.
# AI_USAGE_SHADOW_ENABLED=false
# Динамическое списание только для POST /api/tasks/:id/ai-chat. По умолчанию выключено.
AI_DYNAMIC_TASK_CHAT_BILLING_ENABLED=false
# Опциональный comma-separated canary allowlist user ID.
# AI_DYNAMIC_TASK_CHAT_BILLING_USER_IDS=user-id-1,user-id-2
# Компактный контекст task chat с token-budget history. По умолчанию выключен.
TASK_CHAT_CONTEXT_V2_ENABLED=false
# Опциональный comma-separated canary allowlist user ID.
# TASK_CHAT_CONTEXT_V2_USER_IDS=user-id-1,user-id-2
# Rolling memory task chat (работает только вместе с Context V2).
TASK_CHAT_MEMORY_ENABLED=false
# Опциональный comma-separated canary allowlist user ID. Пустой список включает для всех.
# TASK_CHAT_MEMORY_USER_IDS=user-id-1,user-id-2
OPENAI_MODEL_TASK_CHAT_MEMORY=gpt-6-luna
TASK_CHAT_MEMORY_BATCH_TOKEN_LIMIT=12000
TASK_CHAT_MEMORY_MAX_BATCHES_PER_REQUEST=3
# Опциональный исходящий прокси только для OpenAI
# OPENAI_PROXY_URL=http://1.2.3.4:8080
# OPENAI_PROXY_USERNAME=proxy_user
# OPENAI_PROXY_PASSWORD=proxy_password
# Опциональный исходящий прокси только для Telegram Bot API
# TELEGRAM_PROXY_URL=http://1.2.3.4:8080
# TELEGRAM_PROXY_USERNAME=proxy_user
# TELEGRAM_PROXY_PASSWORD=proxy_password

# Dynamic billing for non-task-chat text workflows. Empty allowlist enables all users.
AI_DYNAMIC_TEXT_BILLING_ENABLED=false
# AI_DYNAMIC_TEXT_BILLING_USER_IDS=user-id-1,user-id-2
AI_CHAT_SMART_CONTEXT_ENABLED=false

# Telegram user-client (MTProto) pilot: globally disabled until explicitly enabled.
# This does NOT affect the existing Telegram bot webhook or its API token.
TELEGRAM_USER_CLIENT_ENABLED=false
# Needed only when authorized user sessions are stored in later PRs.
# Generate once with: openssl rand -hex 32. Store only in Timeweb server secrets.
# TELEGRAM_USER_SESSION_KEY=

# PR2: MTProto QR login for individually allowlisted users.
# Obtain a dedicated app api_id/api_hash at https://my.telegram.org/apps
# Never commit real values. Use Timeweb's private environment settings.
# TELEGRAM_USER_API_ID=
# TELEGRAM_USER_API_HASH=
# TELEGRAM_USER_SESSION_KEY=  # 64 random hexadecimal characters: openssl rand -hex 32
# Switch TELEGRAM_USER_CLIENT_ENABLED=true only after these are configured.

# MTProto raw TCP supports the existing Telegram Bot API HTTP(S) CONNECT proxy.
# Falls back to TELEGRAM_PROXY_URL / TELEGRAM_PROXY_USERNAME /
# TELEGRAM_PROXY_PASSWORD. No new variables needed when those are configured.
# For a separate MTProto proxy, specify all required values:
# TELEGRAM_USER_PROXY_URL=http://host:port
# TELEGRAM_USER_PROXY_USERNAME=
# TELEGRAM_USER_PROXY_PASSWORD=
# Never include proxy credentials in URL, logs or GitHub.

# PR3: independent, default-OFF kill switch for personal Telegram messages.
# Administrative UI requires explicit per-message preview + confirmation.
# Never enable before merging PR3 and reviewing security.
TELEGRAM_USER_SEND_ENABLED=false

# PR4: independently disabled AI draft generation for the manual Telegram composer.
# Requires TELEGRAM_USER_CLIENT_ENABLED=true and TELEGRAM_USER_SEND_ENABLED=true.
# Sends only the operator-entered instruction to OpenAI, never Telegram chats.
TELEGRAM_USER_AI_DRAFT_ENABLED=false
# OPENAI_MODEL_TELEGRAM_DRAFT=gpt-6-luna
