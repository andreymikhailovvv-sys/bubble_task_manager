<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@drawable/widget_quick_ai_background"
    android:gravity="center_vertical" android:orientation="horizontal">
    <LinearLayout android:id="@+id/widget_text_target"
        android:layout_width="0dp" android:layout_height="match_parent"
        android:layout_weight="1" android:layout_marginEnd="8dp"
        android:paddingStart="13dp" android:paddingEnd="8dp"
        android:background="@drawable/widget_quick_ai_input"
        android:gravity="center_vertical" android:orientation="vertical"
        android:contentDescription="Открыть ввод быстрого запроса ИИ">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="✦  Спросить Планировыча…"
            android:textColor="#F4F1FF" android:textSize="14sp" android:singleLine="true"/>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="Например: что важно сегодня?"
            android:textColor="#A6B6D0" android:textSize="10sp"
            android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
    <ImageView android:id="@+id/widget_voice_target"
        android:layout_width="44dp" android:layout_height="44dp"
        android:padding="11dp" android:src="@drawable/ic_widget_microphone"
        android:background="@drawable/widget_quick_ai_voice"
        android:contentDescription="Голосовой быстрый запрос ИИ"/>
</LinearLayout>