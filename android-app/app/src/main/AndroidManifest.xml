<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional user-granted permission for opening the assistant from background. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- Chromium WebView uses the communication audio route for Realtime capture. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- User-approved APK installs for releases distributed outside Google Play. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:name=".PlanirovychApplication" android:allowBackup="false" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:label="Планировыч" android:theme="@style/Theme.Planirovych" android:usesCleartextTraffic="false">
        <!-- Narrow grant-only content URI for privately downloaded APKs. -->
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.update-files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/android_update_paths" />
        </provider>
        <!-- Same Planik realtime frontend as Mini App, authenticated and private. -->
        <activity android:name=".planik.PlanikLiveActivity"
            android:theme="@style/Theme.Planirovych.LiveOverlay"
            android:exported="false" android:windowSoftInputMode="adjustResize" />
        <service android:name=".planik.PlanikWakeBackgroundService" android:exported="false"
            android:foregroundServiceType="microphone" android:stopWithTask="true" />
        <!-- User-selected assistant, not an ordinary exported microphone service. -->
        <service android:name=".planik.PlanikVoiceInteractionService"
            android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION"
            android:label="Планик">
            <intent-filter><action android:name="android.service.voice.VoiceInteractionService" /></intent-filter>
            <meta-data android:name="android.voice_interaction" android:resource="@xml/planik_voice_interaction" />
        </service>
        <service android:name=".planik.PlanikVoiceSessionService"
            android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION" />
        <service android:name=".planik.PlanikAssistantRecognitionService"
            android:exported="true" android:permission="android.permission.BIND_VOICE_INTERACTION">
            <intent-filter><action android:name="android.speech.RecognitionService" /></intent-filter>
            <meta-data android:name="android.speech" android:resource="@xml/planik_recognition_service" />
        </service>
        <activity android:name=".MainActivity" android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".notifications.NotificationActionReceiver" android:exported="false" />
        <service android:name=".notifications.PlanirovychFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <receiver android:name=".widget.QuickAiWidgetProvider"
            android:exported="true" android:label="Быстрый запрос ИИ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/quick_ai_widget_info" />
        </receiver>
        <receiver android:name=".widget.VoiceQuickAiWidgetProvider"
            android:exported="true" android:label="Голосовой ввод ИИ">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/voice_quick_ai_widget_info" />
        </receiver>
    </application>
</manifest>
